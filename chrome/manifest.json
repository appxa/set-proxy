{
  "manifest_version": 3,
  "name": "Set Proxy",
  "description": "Add multiple proxies (SOCKS5/HTTP/HTTPS), select one, switch ON/OFF.",
  "version": "2.0",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-off-16.png",
    "32": "icons/icon-off-32.png",
    "48": "icons/icon-off-48.png",
    "96": "icons/icon-off-96.png",
    "128": "icons/icon-off-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Set Proxy",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  }
}
